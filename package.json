{
  "name": "nexafiles",
  "version": "2.0.0",
  "description": "A file manager that shows you what is actually on your disk, and proves why anything it offers to remove is safe to remove.",
  "main": "main.js",
  "author": "NexaFiles",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-all.js",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "vosk-browser": "^0.0.8"
  },
  "build": {
    "appId": "com.nexafiles.app",
    "productName": "NexaFiles",
    "copyright": "Copyright \u00a9 2026 NexaFiles",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!src/_legacy_index.html",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "NexaFiles needs access to your Desktop to measure what is stored there.",
        "NSDocumentsFolderUsageDescription": "NexaFiles needs access to your Documents to measure what is stored there.",
        "NSDownloadsFolderUsageDescription": "NexaFiles needs access to your Downloads to measure what is stored there.",
        "NSRemovableVolumesUsageDescription": "NexaFiles needs access to removable volumes to measure what is stored on them."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexaFiles"
    },
    "dmg": {
      "title": "NexaFiles",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
